rule qza_to_phyloseq:
    input:
        features = "artifacts/table-filtered.qza",
        tree = "artifacts/rooted-tree.qza",
        taxonomy = "artifacts/taxonomy.qza",
        metadata = config["metadata"]
    threads:
        config['threads']['qza_to_phyloseq']
    output:
        "artifacts/physeq.RDS"
    conda:
        "envs/qiime2r.yaml"
    script:
        "scripts/qza_to_phyloseq.R"

